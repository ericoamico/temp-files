# Servidor
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Banco de dados (SQLite)
DB_FILE_NAME=data/temp-files.db
# TTL da presigned URL de PUT em minutos (controlado pelo servidor)
PUT_URL_TTL_MINUTES=10
# TTL da presigned URL de GET (download) em minutos (controlado pelo servidor)
DOWNLOAD_URL_TTL_MINUTES=5

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pública do bucket/domínio customizado (reservado para uso futuro de download)
R2_PUBLIC_URL=
